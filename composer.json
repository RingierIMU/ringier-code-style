{
    "name": "ringierimu/ringier-code-style",
    "description": "Ringier SA PHP Code Style",
    "license": "MIT",
    "type": "project",
    "keywords": [],
    "authors": [
        {
            "name": "Matthew Nessworthy",
            "email": "matthew.nessworthy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "carthage-software/mago": "^1.57",
        "composer/composer": "^2.10",
        "ergebnis/composer-normalize": "^2.54",
        "laravel-zero/framework": "^13.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "bin": [
        "builds/ringier-code-style"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.28"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "fix-code-style": [
            "./ringier-code-style fix app config bootstrap"
        ]
    }
}
